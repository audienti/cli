#!/usr/bin/env bash
set -euo pipefail

package="@audienti/cli"
binary="audienti"
minimum_node_major=20

say() {
  printf '%s\n' "$*"
}

fail() {
  printf 'Audienti CLI install failed: %s\n' "$*" >&2
  exit 1
}

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    fail "$2"
  fi
}

require_command node "Node.js ${minimum_node_major} or newer is required. Install Node.js, then rerun this script."
require_command npm "npm is required. Install Node.js ${minimum_node_major} or newer with npm, then rerun this script."

node_major="$(node -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null || true)"
case "$node_major" in
  ''|*[!0-9]*)
    fail "could not determine the installed Node.js version."
    ;;
esac

if [ "$node_major" -lt "$minimum_node_major" ]; then
  fail "Node.js ${minimum_node_major} or newer is required. Current version: $(node --version)."
fi

say "Installing ${package}..."
npm install --global --no-audit --no-fund "$package"

global_prefix="$(npm prefix --global 2>/dev/null || true)"
if [ -n "$global_prefix" ] && [ -d "$global_prefix/bin" ]; then
  export PATH="$global_prefix/bin:$PATH"
fi

if ! command -v "$binary" >/dev/null 2>&1; then
  if [ -n "$global_prefix" ] && [ -x "$global_prefix/bin/$binary" ]; then
    fail "${binary} installed at ${global_prefix}/bin/${binary}, but that directory is not on PATH."
  fi

  fail "${binary} was not found on PATH after installation."
fi

"$binary" --help >/dev/null

installed_version="$(node -e 'try { process.stdout.write(require(process.argv[1]).version || "") } catch {}' "$(npm root --global 2>/dev/null || true)/${package}/package.json" 2>/dev/null || true)"

# A saved login means this is an upgrade: stay quiet.
if "$binary" config list --json 2>/dev/null | node -e 'let s="";process.stdin.on("data",(c)=>s+=c).on("end",()=>{try{process.exit(JSON.parse(s).token?0:1)}catch{process.exit(1)}})'; then
  say "Audienti CLI updated to ${installed_version:-the latest version}."
  exit 0
fi

# `curl ... | bash` feeds this script on stdin, so the guided start must read
# the keyboard from the terminal device instead.
tty_device="${AUDIENTI_INSTALL_TTY:-/dev/tty}"
if (: <"$tty_device") 2>/dev/null; then
  say "Audienti CLI${installed_version:+ ${installed_version}} installed."
  say ""
  "$binary" start <"$tty_device" || say "You can pick up where you left off with: audienti start"
  exit 0
fi

cat <<'NEXT'
Audienti CLI installed.

Next:
  audienti start      Sign in or create an account (run it in a terminal)

Without a terminal (CI or a coding agent):
  audienti auth token <token>
  audienti accounts select <acct_id>
  audienti setup --url <company_url> --yes
NEXT
